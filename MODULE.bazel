# Qorix Process Framework - consumed by every Qorix project as a Bazel module.
module(
    name = "qorix_process_framework",
    version = "0.1.0",
)

bazel_dep(name = "rules_python", version = "1.8.5")

# Eclipse SCORE docs-as-code toolchain (Sphinx-needs adapter target).
# Keep in sync with model/tiers/00_score_base/score_base.qpm.yaml (re-import on bump).
bazel_dep(name = "score_docs_as_code", version = "8.3.0")
bazel_dep(name = "score_process_description", version = "2.1.2")

PYTHON_VERSION = "3.12"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "qpm_pip",
    python_version = PYTHON_VERSION,
    requirements_lock = "//tools/qpm:requirements_lock.txt",
)
use_repo(pip, "qpm_pip")
